{
  "name": "statfin-mcp",
  "version": "1.0.0",
  "description": "MCP server for Statistics Finland StatFin database",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npx tsx tests/integration/comprehensive.test.ts",
    "test:integration:smoke": "npx tsx tests/integration/smoke.test.ts",
    "test:fixtures:fetch": "npx tsx tests/fetch-fixtures.ts",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "statistics",
    "finland",
    "statfin",
    "tilastokeskus",
    "pxweb",
    "claude",
    "ai",
    "llm"
  ],
  "author": "Markus Lindqvist",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markusl/statfin-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/markusl/statfin-mcp/issues"
  },
  "homepage": "https://github.com/markusl/statfin-mcp#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "lru-cache": "^11.0.0",
    "pino": "^10.1.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.16"
  }
}
